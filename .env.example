# Required. Protects the write endpoints of the API. Generate one with: openssl rand -hex 32
API_KEY=
NEXT_PUBLIC_API_URL=
COLLECTION_INTERVAL_SECONDS=3600
POWER_BASE_W=5.0
POWER_MAX_W=15.0

# Host used by Traefik router for docker-compose.dev.yml (local default)
TRAEFIK_CLIENT_HOST=dev.beskarfox.com

# Comma-separated list consumed by Next.js allowedDevOrigins
ALLOWED_DEV_ORIGINS=dev.beskarfox.com,stats.staging.beskarfox.com,localhost,127.0.0.1

# --- Backup Configuration ---
# Interval for checking if a backup is needed (in seconds, default: 3600)
BACKUP_CHECK_INTERVAL_SECONDS=3600
# Maximum age of the last backup before a new one is triggered (in seconds, default: 604800 / 7 days)
BACKUP_AGE_THRESHOLD_SECONDS=604800

# Retention limits (number of archives to keep). Set to 0 to disable backups for that service.
# Default is 0 (disabled) if the variable is not set.
MAX_BACKUPS_NEXTCLOUD=0
MAX_BACKUPS_MINECRAFT=0
MAX_BACKUPS_OUTLINE=0

# Nextcloud MariaDB credentials used by mysqldump (required for Nextcloud backups)
NEXTCLOUD_DB_USER=
NEXTCLOUD_DB_PASSWORD=

# Ollama API URL (used when Ollama runs natively on the host, outside Docker)
OLLAMA_API_URL=http://host.docker.internal:11434

